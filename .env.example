# Public site URL (used for metadata / links)
NEXT_PUBLIC_SITE_URL=https://fakhm.example

# Supabase — leave empty to run with the sample catalogue in lib/sample-products.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Order emails (https://resend.com)
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=fakhm.perfume@gmail.com
# Needs a domain verified in Resend; defaults to Resend's test sender.
ORDER_FROM_EMAIL="FAKHM Orders <orders@fakhm.example>"

# Shared secret for POST /api/revalidate
REVALIDATE_SECRET=
